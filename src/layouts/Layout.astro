---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { getLangFromUrl, useTranslations, useTranslatedPath, getRawPath } from '../i18n/utils';
import { LOCALES, getLocale } from '../i18n/config';
import { THEMES, DEFAULT_THEME, THEME_STORAGE_KEY } from '../theme/config';
import CommandBar from '../components/CommandBar.astro';
import { BUILD_TIME } from '../utils/buildTime';
import { LOCATION } from '../config/location';
import { WEATHER_BUCKETS } from '../config/weather';

const themeCodes = THEMES.map((t) => t.code);

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Relmy Mathieu's personal site, aspiring nuclear engineer, dev, nerd.",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const rawPath = getRawPath(Astro.url, lang);
const langLinks = LOCALES.map((l) => ({
  ...l,
  href: useTranslatedPath(l.code)(rawPath),
  active: l.code === lang,
}));

const currentLocale = getLocale(lang);
const htmlLang = currentLocale.htmlLang;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.svg', Astro.site);
const buildTimeFormatted = `${new Intl.DateTimeFormat(htmlLang, {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'UTC',
}).format(new Date(BUILD_TIME))} (UTC)`;

const weatherLabels = Object.fromEntries(
  WEATHER_BUCKETS.map((bucket) => [bucket, t(`weather.${bucket}`)]),
);
---

<html lang={htmlLang}>
  <head>
    <script
      is:inline
      define:vars={{ themeCodes, fallback: DEFAULT_THEME, storageKey: THEME_STORAGE_KEY }}
    >
      try {
        const stored = localStorage.getItem(storageKey);
        document.documentElement.dataset.theme = themeCodes.includes(stored) ? stored : fallback;
      } catch {
        document.documentElement.dataset.theme = fallback;
      }
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Relmy Mathieu - ${t('blog.title')}`}
      href={translatePath('/rss.xml')}
    />

    <title>{title} - Relmy Mathieu</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={`${title} - Relmy Mathieu`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} - Relmy Mathieu`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />
    <noscript>
      <style>
        [data-fade-in] { opacity: 1 !important; transform: none !important; }
        #boot-screen { display: none !important; }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col font-mono">
    <div id="boot-screen" aria-hidden="true" data-lines={t('boot.lines')}>
      <div id="boot-lines"></div>
    </div>
    <a href="#main-content" class="skip-link">{t('nav.skip')}</a>
    <nav class="nav-bar">
      <a href={translatePath('/')} class="nav-link">{t('nav.home')}</a>
      <a href={translatePath('/blog')} class="nav-link">{t('nav.blog')}</a>
      <div class="ml-auto flex items-center gap-2">
        <div
          class="nav-np"
          id="now-playing"
          data-np-last-prefix={t('np.lastPrefix')}
          data-np-paused={t('np.paused')}
          hidden
        >
          <button
            class="nav-np__trigger"
            type="button"
            aria-label={t('np.label')}
            aria-expanded="false"
            aria-describedby="np-menu"
          >[<span class="nav-np__glyph" aria-hidden="true">♪</span>]</button>
          <div class="nav-np__menu" id="np-menu" role="tooltip"></div>
        </div>
        <span
          class="nav-clock"
          id="status-clock"
          data-weather-labels={JSON.stringify(weatherLabels)}
        >[{LOCATION.city} --:--]</span>
        <CommandBar lang={lang} />
        <div class="dropdown" id="theme-dropdown">
          <button
            id="theme-toggle"
            type="button"
            aria-haspopup="menu"
            aria-controls="theme-menu"
            aria-expanded="false"
            aria-label={t('theme.label')}
            data-label-base={t('theme.label')}
            class="nav-link cursor-pointer"
          >[<span class="theme-swatch"></span> ▾]</button>
          <div class="dropdown-menu" id="theme-menu" role="menu" aria-label={t('theme.label')} aria-hidden="true">
            {THEMES.map((th) => (
              <button
                type="button"
                role="menuitemradio"
                aria-checked="false"
                class="dropdown-option theme-option"
                data-theme-code={th.code}
              >
                <span class="theme-swatch" style={`--swatch: ${th.swatch}`}></span>{th.label}
              </button>
            ))}
          </div>
        </div>
        <div class="dropdown" id="lang-dropdown">
          <button
            id="lang-toggle"
            type="button"
            aria-haspopup="menu"
            aria-controls="lang-menu"
            aria-expanded="false"
            aria-label={t('lang.label')}
            class="nav-link cursor-pointer"
          >[{currentLocale.short} ▾]</button>
          <div class="dropdown-menu" id="lang-menu" role="menu" aria-label={t('lang.menu')} aria-hidden="true">
            {langLinks.map((l) => (
              <a
                href={l.href}
                role="menuitem"
                lang={l.htmlLang}
                class:list={['dropdown-option', { 'dropdown-option--active': l.active }]}
                aria-current={l.active ? 'page' : undefined}
                aria-label={t('lang.switchTo').replace('{name}', l.label)}
              >{l.short}</a>
            ))}
          </div>
        </div>
      </div>
    </nav>
    <main id="main-content" class="flex-1 w-full max-w-3xl mx-auto px-6 py-10">
      <slot />
    </main>
    <footer class="status-bar">
      <span class="status-seg status-seg--muted">{t('footer.credit')}</span>
      <span
        class="status-seg status-seg--muted dashed-hint"
        id="status-uptime"
        tabindex="0"
        data-build-time={BUILD_TIME}
        data-uptime-label={t('footer.uptimeLabel')}
        data-tip={t('footer.uptimeTip').replace('{time}', buildTimeFormatted)}
      ></span>
      <span class="status-seg status-seg--muted">{t('footer.status')}</span>
      <span class="status-seg status-seg--muted" id="footer-kaomoji" aria-hidden="true">(｡･∀･)ﾉﾞ</span>
    </footer>
    <script>
      import '../scripts/theme';
      import '../scripts/theme-dropdown';
      import '../scripts/lang-dropdown';
      import '../scripts/clock';
      import '../scripts/fade-in';
      import '../scripts/uptime';
      import '../scripts/boot';
      import '../scripts/kaomoji';
      import '../scripts/now-playing';
    </script>
  </body>
</html>

<style>
  #boot-screen {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: #000000;
    color: #ffffff;
    font-size: 0.8125rem;
    padding: 1.5rem;
  }

  [data-booted='1'] #boot-screen {
    display: none;
  }

  #boot-lines {
    white-space: pre-wrap;
    line-height: 1.6;
    opacity: 0.85;
  }

  :global(.boot-ok) {
    color: #22c55e;
    font-weight: 600;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    background: var(--text-main);
    color: var(--surface-bg);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    text-decoration: none;
    z-index: 100;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 0;
    outline: 2px dashed currentColor;
    outline-offset: 2px;
  }

  .nav-bar {
    height: 3.5rem;
    border-bottom: 1px solid var(--border);
    padding-inline: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0;
    font-size: 0.875rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    min-height: 2.75rem;
  }

  .nav-link:hover {
    text-decoration: underline;
  }

  .nav-link:focus-visible {
    outline: 2px dashed currentColor;
    outline-offset: 2px;
  }

  .dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 5px);
    background: var(--menu-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    min-width: 4rem;
    z-index: 50;
    display: flex;
    flex-direction: column;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 0.16s ease,
      clip-path 0.24s cubic-bezier(0.05, 0.9, 0.1, 1.05),
      visibility 0s linear 0.24s;
  }

  .dropdown-menu.is-open {
    opacity: 1;
    clip-path: inset(0 0 0% 0);
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 0.16s ease,
      clip-path 0.24s cubic-bezier(0.05, 0.9, 0.1, 1.05),
      visibility 0s linear 0s;
  }

  .dropdown-option {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    text-align: center;
  }

  .dropdown-option:hover {
    text-decoration: underline;
  }

  .dropdown-option:focus-visible {
    outline: 2px dashed currentColor;
    outline-offset: 2px;
  }

  .dropdown-option--active {
    font-weight: 700;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    background: none;
    border: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: left;
    white-space: nowrap;
  }

  .theme-swatch {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: var(--swatch, var(--theme-swatch));
    transition: background-color 0.18s ease;
  }

  .status-bar {
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.55rem 1rem;
    margin-top: 2.5rem;
    font-size: 0.7rem;
    color: var(--text-subtle);
    letter-spacing: 0.02em;
  }

  .status-seg {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .status-seg--muted {
    color: var(--text-subtle);
    opacity: 0.85;
  }

  .nav-clock {
    font-size: 0.75rem;
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
    padding: 0 0.35rem;
    white-space: nowrap;
  }

  .nav-np {
    position: relative;
  }

  .nav-np[hidden] {
    display: none;
  }

  .nav-np__trigger {
    font-size: 0.75rem;
    color: var(--text-subtle);
    letter-spacing: 0.03em;
    padding: 0.5rem 0.35rem;
    cursor: pointer;
  }

  .nav-np__trigger:focus-visible {
    outline: 2px dashed currentColor;
    outline-offset: 2px;
  }

  .nav-np__glyph {
    display: inline-block;
  }

  /* TODO : Could improve the looks to show it more lively, like "HEY THERES SOMETHING HOVERABLE THERE" */
  .nav-np.is-playing .nav-np__glyph {
    animation: np-pulse 2.4s ease-in-out infinite;
  }

  .nav-np.is-pinned .nav-np__trigger {
    color: var(--text-main);
  }

  @keyframes np-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 1; }
  }

  .nav-np::after {
    content: '';
    position: absolute;
    inset: 100% 0 auto 0;
    height: 7px;
  }

  .nav-np__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 5px);
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    width: max-content;
    max-width: min(17rem, 70vw);
    padding: 0.55rem 0.7rem;
    background: var(--menu-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.75rem;
    text-align: left;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 0.16s ease,
      clip-path 0.24s cubic-bezier(0.05, 0.9, 0.1, 1.05),
      visibility 0s linear 0.24s;
  }

  .nav-np:hover .nav-np__menu,
  .nav-np:focus-within .nav-np__menu,
  .nav-np.is-pinned .nav-np__menu {
    opacity: 1;
    clip-path: inset(0 0 0% 0);
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 0.16s ease,
      clip-path 0.24s cubic-bezier(0.05, 0.9, 0.1, 1.05),
      visibility 0s linear 0s;
  }

  :global(.np-status) {
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.65rem;
  }

  :global(.np-title) {
    font-weight: 600;
    color: var(--text-main);
    overflow-wrap: anywhere;
  }

  :global(a.np-title:hover) {
    text-decoration: underline;
  }

  :global(.np-artist) {
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  :global(.np-album) {
    color: var(--text-subtle);
    font-size: 0.7rem;
    overflow-wrap: anywhere;
  }

  :global(.np-progress) {
    display: block;
    height: 2px;
    margin-top: 0.35rem;
    background: var(--border);
    border-radius: 1px;
    overflow: hidden;
  }

  :global(.np-bar) {
    display: block;
    height: 100%;
    background: var(--accent, currentColor);
    transform-origin: left center;
    transform: scaleX(0);
    animation-name: np-progress;
    animation-timing-function: linear;
    animation-fill-mode: both;
  }

  @keyframes np-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  :global(.np-time) {
    color: var(--text-subtle);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-np.is-playing .nav-np__glyph { animation: none; }
  }

  @media (max-width: 820px) {
    .nav-np { display: none; }
  }

  @media (max-width: 480px) {
    .nav-clock { display: none; }
  }
</style>
