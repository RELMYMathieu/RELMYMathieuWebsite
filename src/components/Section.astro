---
interface Props {
  class?: string;
  dashed?: boolean;
  bare?: boolean;
  bleed?: boolean;
  delay?: number;
}

const { class: className, dashed = false, bare = false, bleed = false, delay = 0 } = Astro.props;
---

<section
  class:list={[
    'section-card',
    dashed && 'section-card--dashed',
    bare && 'section-card--bare',
    bleed && 'section-card--bleed',
    className,
  ]}
  data-fade-in
  data-fade-delay={delay}
>
  <slot />
</section>

<style>
  .section-card {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    transition: border-color 0.22s ease;
    isolation: isolate;
  }

  .section-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: linear-gradient(135deg, var(--sheen), transparent 65%);
    opacity: 0;
    pointer-events: none;
    z-index: -1;
    transition: opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .section-card:hover {
    border-color: var(--border-hover);
  }

  .section-card:hover::before {
    opacity: 1;
  }

  .section-card--dashed {
    border-style: dashed;
  }

  .section-card--bare {
    border: none;
    border-radius: 0;
    padding: 0;
    margin-bottom: 2rem;
  }

  .section-card--bare + .section-card--bare {
    border-top: 1px var(--divider-style, dashed) var(--divider-color, var(--border));
    box-shadow: var(--divider-shadow, none);
    padding-top: 2rem;
  }

  .section-card--bare::before {
    display: none;
  }

  .section-card--bleed {
    margin-inline: -1.5rem;
    margin-bottom: 1.5rem;
    padding-inline: calc(1.5rem - 1px);
  }
</style>
