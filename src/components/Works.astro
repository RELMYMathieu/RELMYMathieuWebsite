---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import { isLangFile, getWorkKey } from '../utils/collections';
import { getCollection, render } from 'astro:content';

interface Props {
  lang: Lang;
  delay?: number;
}

const { lang, delay = 0.2 } = Astro.props;
const t = useTranslations(lang);

const allWorks = await getCollection('works', ({ id, filePath }) => {
  return isLangFile(filePath, id, lang);
});

const works = await Promise.all(
  allWorks
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
    .map(async (work) => {
      const { Content } = await render(work);
      const workKey = getWorkKey(work.filePath, work.id, lang);

      return {
        id: workKey,
        name: work.data.name,
        meta: work.data.meta,
        path: work.data.path,
        links: work.data.links,
        stack: work.data.stack,
        image: work.data.image,
        Content,
      };
    }),
);
---

<Section delay={delay}>
  <h2 class="font-bold mb-3 text-sm uppercase tracking-widest text-subtle">
    <span class="dashed-hint" tabindex="0" data-tip={t('works.heading.tip')}>{t('works.heading')}</span>
  </h2>
  <ul class="works-list" role="list">
    {works.map((w) => (
      <li>
        <button
          class="work-item"
          type="button"
          data-ww-trigger
          aria-haspopup="dialog"
          aria-controls={`ww-${w.id}`}
        >
          <span class="work-item__name">{w.name}</span>
          <span class="work-item__meta">{w.meta}</span>
          <span class="work-item__open" aria-hidden="true">{t('works.open')}</span>
        </button>
      </li>
    ))}
  </ul>
</Section>

<div class="ww-backdrop" id="ww-backdrop" aria-hidden="true"></div>

{works.map((w) => (
  <div
    id={`ww-${w.id}`}
    class="ww"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby={`ww-label-${w.id}`}
    aria-describedby={`ww-desc-${w.id}`}
    tabindex="-1"
    data-work-id={w.id}
  >
    <div class="ww-titlebar" data-drag-handle>
      <span class="ww-titlebar__prompt" aria-hidden="true">work@relmymathieu</span>
      <span class="ww-titlebar__sep" aria-hidden="true">:</span>
      <span class="ww-titlebar__path" id={`ww-label-${w.id}`}>{w.path}</span>
      <div class="ww-controls">
        <button class="ww-ctrl ww-ctrl--desktop" data-action="minimize" type="button" aria-label={t('ww.minimize')}>[−]</button>
        <button class="ww-ctrl ww-ctrl--desktop" data-action="fullscreen" type="button" aria-label={t('ww.fullscreen')}>[□]</button>
        <button class="ww-ctrl" data-action="close" type="button" aria-label={t('works.close').replace('{name}', w.name)}>[×]</button>
      </div>
    </div>
    <div class="ww-body" id={`ww-desc-${w.id}`}>
      {w.image ? (
        <div class="ww-header-img-wrap">
          <Image
            src={w.image}
            alt={w.name}
            class="ww-header-img"
            inferSize
            loading="lazy"
            decoding="async"
          />
        </div>
      ) : (
        <div class="ww-img-placeholder" aria-hidden="true">
          <span class="ww-img-placeholder__text" aria-hidden="true">{t('works.placeholder')}</span>
        </div>
      )}
      <div class="ww-content">
        <div class="prose-mdx">
            <w.Content />
        </div>
        <div class="ww-links">
          {w.links.map((l) => (
            <a href={l.href} aria-label={l.label} target="_blank" rel="noopener noreferrer" class="ww-link">{l.label}</a>
          ))}
        </div>
        <p class="ww-stack">{w.stack}</p>
      </div>
    </div>
  </div>
))}

<style>
  .works-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .work-item {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.625rem 0.5rem;
    min-height: 2.75rem;
    background: none;
    border: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: left;
    border-bottom: 1px dashed var(--border);
    border-radius: var(--radius);
    transition: border-color 0.18s ease;
    isolation: isolate;
  }

  .work-item::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: linear-gradient(90deg, var(--sheen), transparent 70%);
    opacity: 0;
    pointer-events: none;
    z-index: -1;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .work-item:hover {
    border-color: var(--border-hover);
  }

  .work-item:hover::before {
    opacity: 1;
  }
  .work-item:hover .work-item__open { opacity: 1; }

  .work-item:focus-visible {
    outline: 2px dashed currentColor;
    outline-offset: 3px;
  }

  .work-item__name { font-size: 0.875rem; }

  .work-item__meta {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }

  .work-item__open {
    font-size: 0.75rem;
    opacity: 0.45;
    transition: opacity 0.15s;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .work-item {
      grid-template-columns: 1fr auto;
      row-gap: 0.15rem;
    }
  }

</style>

<script>
  import '../scripts/window-manager';
</script>
