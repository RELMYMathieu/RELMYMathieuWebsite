---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { getLangFromUrl, useTranslations, useTranslatedPath, getRawPath } from '../i18n/utils';
import { LOCALES, getLocale } from '../i18n/config';
import { THEMES, DEFAULT_THEME, THEME_STORAGE_KEY } from '../theme/config';
import CommandBar from '../components/CommandBar.astro';
import ThemePicker from '../components/ThemePicker.astro';
import { BUILD_TIME } from '../utils/buildTime';
import { LOCATION } from '../config/location';
import { WEATHER_BUCKETS } from '../config/weather';
import { MOOD_LINE_KEYS, MOOD_PHASES, PHASE_BY_HOUR, DEFAULT_PHASE } from '../config/mood';

const themeCodes = THEMES.map((t) => t.code);
const moodHours = [...PHASE_BY_HOUR];

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Relmy Mathieu's personal site, aspiring nuclear engineer, dev, nerd.",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const rawPath = getRawPath(Astro.url, lang);
const langLinks = LOCALES.map((l) => ({
  ...l,
  href: useTranslatedPath(l.code)(rawPath),
  active: l.code === lang,
}));

const currentLocale = getLocale(lang);
const htmlLang = currentLocale.htmlLang;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.svg', Astro.site);
const buildTimeFormatted = `${new Intl.DateTimeFormat(htmlLang, {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'UTC',
}).format(new Date(BUILD_TIME))} (UTC)`;

const weatherLabels = Object.fromEntries(
  WEATHER_BUCKETS.map((bucket) => [bucket, t(`weather.${bucket}`)]),
);

const moodLines = Object.fromEntries(
  MOOD_LINE_KEYS.map((key) => [
    key,
    t(`mood.${key}`)
      .split('\n')
      .map((line) => line.replace(/\{city\}/g, LOCATION.city)),
  ]),
);
const moodPhaseLabels = Object.fromEntries(
  MOOD_PHASES.map((phase) => [phase, t(`mood.phase.${phase}`)]),
);

const homeLabel = t('nav.home');
const homeSlash = homeLabel.indexOf('/');
const homeRoot = homeSlash === -1 ? homeLabel : homeLabel.slice(0, homeSlash);
const homeRest = homeSlash === -1 ? '' : homeLabel.slice(homeSlash);
---

<html lang={htmlLang}>
  <head>
    <script
      is:inline
      define:vars={{
        themeCodes,
        fallback: DEFAULT_THEME,
        storageKey: THEME_STORAGE_KEY,
        moodHours,
        moodTz: LOCATION.timeZone,
        moodFallback: DEFAULT_PHASE,
      }}
    >
      try {
        const stored = localStorage.getItem(storageKey);
        document.documentElement.dataset.theme = themeCodes.includes(stored) ? stored : fallback;
      } catch {
        document.documentElement.dataset.theme = fallback;
      }

      try {
        const hour = Number(
          new Intl.DateTimeFormat('en-GB', {
            hour: '2-digit',
            hourCycle: 'h23',
            timeZone: moodTz,
          }).format(new Date()),
        );
        document.documentElement.dataset.moodPhase = moodHours[hour] ?? moodFallback;
      } catch {
        document.documentElement.dataset.moodPhase = moodFallback;
      }
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Relmy Mathieu - ${t('blog.title')}`}
      href={new URL(translatePath('/rss.xml'), Astro.site ?? canonical)}
    />

    <title>{title} - Relmy Mathieu</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={`${title} - Relmy Mathieu`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} - Relmy Mathieu`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />
    <noscript>
      <style>
        [data-fade-in] { opacity: 1 !important; transform: none !important; }
        #boot-screen { display: none !important; }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col font-mono">
    <div
      id="boot-screen"
      aria-hidden="true"
      data-lines={t('boot.lines')}
      data-last-login={t('boot.lastLogin')}
      data-first-login={t('boot.firstLogin')}
      data-login-locale={htmlLang}
    >
      <div id="boot-lines"></div>
    </div>
    <a href="#main-content" class="skip-link">{t('nav.skip')}</a>
    <nav class="nav-bar">
      <a href={translatePath('/')} class="nav-link" aria-label={homeLabel}>{homeRoot}<span class="nav-link__rest">{homeRest}</span></a>
      <a href={translatePath('/blog')} class="nav-link">{t('nav.blog')}</a>
      <div class="ml-auto flex items-center gap-2">
        <div
          class="nav-np"
          id="now-playing"
          data-np-last-prefix={t('np.lastPrefix')}
          data-np-paused={t('np.paused')}
          hidden
        >
          <button
            class="nav-np__trigger"
            type="button"
            data-nav-menu-trigger
            aria-label={t('np.label')}
            aria-expanded="false"
            aria-describedby="np-menu"
          >[<span class="nav-np__glyph" aria-hidden="true">♪</span>]</button>
          <div class="nav-np__menu" id="np-menu" role="tooltip"></div>
        </div>
        <div
          class="nav-clock"
          id="status-clock"
          data-weather-labels={JSON.stringify(weatherLabels)}
          data-time-zone={LOCATION.timeZone}
          data-city={LOCATION.city}
        >
          <button
            class="nav-clock__trigger"
            type="button"
            data-nav-menu-trigger
            aria-label={t('clock.label')}
            aria-expanded="false"
            aria-describedby="clock-menu"
          >[<span class="nav-clock__city">{LOCATION.city} </span>--:--]</button>
          <div class="nav-clock__menu" id="clock-menu" role="tooltip"></div>
        </div>
        <CommandBar lang={lang} />
        <button
          id="theme-trigger"
          type="button"
          data-ww-trigger
          aria-haspopup="dialog"
          aria-controls="ww-theme"
          aria-label={t('theme.label')}
          data-label-base={t('theme.label')}
          class="nav-link cursor-pointer"
        >[<span class="theme-trigger__word">{t('theme.button')} </span><span class="theme-swatch"></span>]</button>
        <div class="dropdown" id="lang-dropdown">
          <button
            id="lang-toggle"
            type="button"
            aria-haspopup="menu"
            aria-controls="lang-menu"
            aria-expanded="false"
            aria-label={t('lang.label')}
            class="nav-link cursor-pointer"
          >[{currentLocale.short} ▾]</button>
          <div class="dropdown-menu" id="lang-menu" role="menu" aria-label={t('lang.menu')} aria-hidden="true">
            {langLinks.map((l) => (
              <a
                href={l.href}
                role="menuitem"
                lang={l.htmlLang}
                class:list={['dropdown-option', { 'dropdown-option--active': l.active }]}
                aria-current={l.active ? 'page' : undefined}
                aria-label={t('lang.switchTo').replace('{name}', l.label)}
              >{l.short}</a>
            ))}
          </div>
        </div>
      </div>
    </nav>
    <main id="main-content" class="flex-1 w-full max-w-3xl mx-auto px-6 py-10">
      <slot />
    </main>
    <div class="ww-backdrop" id="ww-backdrop" aria-hidden="true"></div>
    <ThemePicker lang={lang} />
    <footer class="status-bar">
      <span class="status-seg status-seg--muted">{t('footer.credit')}</span>
      <span
        class="status-seg status-seg--muted dashed-hint"
        id="status-uptime"
        tabindex="0"
        data-build-time={BUILD_TIME}
        data-uptime-label={t('footer.uptimeLabel')}
        data-tip={t('footer.uptimeTip').replace('{time}', buildTimeFormatted)}
      ></span>
      <span
        class="status-seg status-seg--muted status-seg--line"
        id="status-line"
        data-mood-lines={JSON.stringify(moodLines)}
      >{t('footer.status')}</span>
      <span class="status-seg status-seg--muted" id="footer-kaomoji" aria-hidden="true">(｡･∀･)ﾉﾞ</span>
    </footer>
    <script>
      import '../scripts/theme';
      import '../scripts/theme-picker';
      import '../scripts/lang-dropdown';
      import '../scripts/clock';
      import '../scripts/fade-in';
      import '../scripts/uptime';
      import '../scripts/boot';
      import '../scripts/kaomoji';
      import '../scripts/now-playing';
      import '../scripts/age';
      import '../scripts/mood';
      import '../scripts/last-login';
    </script>
  </body>
</html>

